@model CartViewModel
@{ ViewData["Title"] = "Shporta"; }
<section class="page-header"><div class="container"><span class="eyebrow">PrinciGold</span><h1>Shporta jote</h1></div></section>
<div class="container section">@if (!Model.Items.Any()) { <div class="empty-state"><span class="eyebrow">Gati për zbulim</span><h2>Shporta është bosh.</h2><p>Zgjidhni një detaj të veçantë nga koleksioni PrinciGold.</p><a class="button" asp-controller="Catalog" asp-action="Index">Zbulo koleksionin</a></div> } else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Produkti</th><th>Sasia</th><th>Çmimi</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><strong>@item.Product.Name</strong><small class="cart-category">@item.Product.Category?.Name</small></td><td><form class="quantity-form" asp-action="Update" method="post"><input type="hidden" name="productId" value="@item.Product.Id" /><input class="quantity" type="number" name="quantity" value="@item.Quantity" min="0" max="@item.Product.StockQuantity" aria-label="Sasia për @item.Product.Name" /><button class="text-button" type="submit">Përditëso</button></form></td><td>@item.Total.ToString("0.00")€</td><td><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.Product.Id" /><button class="text-button" type="submit">Hiq</button></form></td></tr> }</tbody></table></div><div class="cart-summary"><div><span class="eyebrow">Totali i porosisë</span><h2>@Model.SubTotal.ToString("0.00")€</h2><p>Transporti llogaritet falas për porosi mbi 100€.</p></div><a class="button" asp-action="Checkout">Vazhdo te checkout</a></div> }</div>

