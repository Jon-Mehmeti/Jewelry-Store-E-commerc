@model IEnumerable<Order>
@{ ViewData["Title"] = "Porositë e mia"; }
<section class="page-header"><div class="container"><span class="eyebrow">Llogaria ime</span><h1>Porositë e mia</h1></div></section><div class="container section"><table class="data-table"><thead><tr><th>Porosia</th><th>Data</th><th>Statusi</th><th>Total</th></tr></thead><tbody>@foreach (var order in Model) { <tr><td>#@order.OrderNumber</td><td>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td>@order.Status</td><td>@order.TotalAmount.ToString("0.00")€</td></tr> }</tbody></table></div>
