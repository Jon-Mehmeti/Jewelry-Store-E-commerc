@model HomeViewModel
@{ ViewData["Title"] = "Koleksioni yt"; }
<section class="hero"><div class="hero-content"><span class="eyebrow">PrinciGold · Gjilan</span><h1>Shkëlqim që<br /><em>të përket.</em></h1><p>Bizhuteri të kuruara me kujdes, për dhurata të paharrueshme dhe momente që meritojnë të shkëlqejnë.</p><div class="hero-actions"><a class="button" asp-controller="Catalog" asp-action="Index">Zbulo koleksionin</a><a class="button button-outline" href="#benefits">Pse PrinciGold?</a></div></div></section>
<section class="benefits" id="benefits"><div class="container benefits-grid"><div><strong>01</strong><span>Materiale të zgjedhura</span><small>Detaje që zgjasin</small></div><div><strong>02</strong><span>Dërgesë e sigurt</span><small>Paketim premium dhurate</small></div><div><strong>03</strong><span>Shërbim në Gjilan</span><small>Na vizitoni në Gjilan</small></div><div><strong>04</strong><span>Zgjedhje me stil</span><small>Koleksione për çdo rast</small></div></div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">Përzgjedhja jonë</span><h2>Favoritet e PrinciGold</h2></div><a class="link-arrow" asp-controller="Catalog" asp-action="Index">Shiko të gjitha →</a></div><div class="product-grid">@foreach (var product in Model.FeaturedProducts) { <partial name="_ProductCard" model="product" /> }</div></section>
<section class="promo-banner"><div class="container promo-content"><div><span class="eyebrow">Dhurata perfekte</span><h2>Një detaj i vogël.<br /><em>Një kujtim i madh.</em></h2></div><a class="button" asp-controller="Catalog" asp-action="Index" asp-route-sort="price-low">Gjej dhuratën</a></div></section>
<section class="section story" id="story"><div class="container story-grid"><div><span class="eyebrow">Historia jonë</span><h2>Detajet kanë<br /><em>rëndësi.</em></h2><p>PrinciGold sjell përzgjedhje elegante në Gjilan. Çdo produkt zgjidhet me kujdes për cilësinë, dizajnin dhe emocionin që përcjell.</p><a class="link-arrow" asp-controller="Catalog" asp-action="Index">Njihuni me koleksionin →</a></div><div class="story-art"></div></div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">Gjej stilin tënd</span><h2>Kategoritë</h2></div><a class="link-arrow" asp-controller="Catalog" asp-action="Index">Eksploro →</a></div><div class="category-grid">@foreach (var category in Model.Categories) { <a class="category-tile" asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@category.Id"><span class="eyebrow">PrinciGold collection</span><h3>@category.Name →</h3></a> }</div></section>
