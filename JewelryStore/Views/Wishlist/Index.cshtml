@model Wishlist
@{ ViewData["Title"] = "Wishlist"; }
<section class="page-header"><div class="container"><span class="eyebrow">Koleksioni yt</span><h1>Wishlist</h1></div></section><div class="container section"><div class="product-grid">@foreach (var item in Model.Items.Where(item => item.Product is not null)) { <partial name="~/Views/Shared/_ProductCard.cshtml" model="item.Product" /> }</div>@if (!Model.Items.Any()) { <p>Nuk ke ende produkte të ruajtura.</p> }</div>
