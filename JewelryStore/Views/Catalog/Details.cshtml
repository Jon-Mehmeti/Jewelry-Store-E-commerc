@model Product
@{ ViewData["Title"] = Model.Name; }
<div class="container detail-grid"><div class="detail-image">@if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="@Model.Name" /> } else { <span class="image-placeholder">PRINCIGOLD</span> }</div><div class="detail-copy"><span class="eyebrow">@Model.Category?.Name</span><h1>@Model.Name</h1>@if (User.Identity?.IsAuthenticated == true) { <div class="detail-price">@((Model.DiscountPrice ?? Model.Price).ToString("0.00")) € @if (Model.DiscountPrice.HasValue) { <del>@Model.Price.ToString("0.00") €</del> }</div> } else { <div class="detail-price guest-price">Kyçu për të parë çmimin</div> }<p>@Model.Description</p><p><strong>Materiali:</strong> @Model.Material @if (!string.IsNullOrWhiteSpace(Model.Color)) { <span>· @Model.Color</span> }</p>@if (User.Identity?.IsAuthenticated == true) { <form class="form-row" asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id" /><input class="quantity" type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity" /><button class="button" type="submit">Shto në shportë</button></form><p class="eyebrow">@Model.StockQuantity copë në stok</p><form asp-controller="Wishlist" asp-action="Toggle" method="post"><input type="hidden" name="productId" value="@Model.Id" /><button class="text-button" type="submit">♡ Shto në wishlist</button></form> } else { <a class="button" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Hyr për të porositur</a><p class="guest-hint">Regjistrohu ose kyçu për të parë çmimin, për të porositur dhe për të ruajtur produktin në wishlist.</p> }</div></div>

