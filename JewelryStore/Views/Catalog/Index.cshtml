@model CatalogViewModel
@{ ViewData["Title"] = "Koleksioni"; }
<section class="page-header"><div class="container"><span class="eyebrow">PrinciGold</span><h1>Koleksioni</h1></div></section>
<div class="container"><form class="filters" method="get"><input class="input" name="search" value="@Model.Search" placeholder="Kërko një produkt..." /><select class="select" name="categoryId"><option value="">Të gjitha kategoritë</option>@foreach (var category in Model.Categories) { <option value="@category.Id" selected="@(Model.CategoryId == category.Id ? "selected" : null)">@category.Name</option> }</select><select class="select" name="sort"><option value="featured" selected="@(Model.Sort == "featured" ? "selected" : null)">Të rekomanduara</option><option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">Më të rejat</option><option value="price-low" selected="@(Model.Sort == "price-low" ? "selected" : null)">Çmimi: ulët-lartë</option><option value="price-high" selected="@(Model.Sort == "price-high" ? "selected" : null)">Çmimi: lartë-ulët</option></select><button class="button dark" type="submit">Filtro</button>@if (!string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue || Model.Sort != "featured") { <a class="button button-reset" asp-action="Index">Pastro filtrat</a> }</form><section class="section"><div class="section-heading"><div><span class="eyebrow">PrinciGold</span><h2>Eksploro koleksionin</h2></div><span class="result-count">@Model.Products.Count produkte</span></div><div class="product-grid">@foreach (var product in Model.Products) { <partial name="_ProductCard" model="product" /> }</div>@if (!Model.Products.Any()) { <div class="empty-state"><h2>Nuk u gjet asnjë produkt.</h2><p>Provo një kërkim tjetër ose pastro filtrat.</p></div> }</section></div>

