@model Order
@{ ViewData["Title"] = "Detajet e porosisë"; }
<section class="page-header"><div class="container"><span class="eyebrow">Admin · vetëm për staf · #@Model.OrderNumber</span><h1>Detajet e porosisë</h1></div></section><div class="container section"><div class="order-detail-grid"><div class="order-customer-card"><span class="eyebrow">Klienti</span><h2>@Model.User?.Email</h2><p>@Model.ShippingAddress<br />@Model.City, @Model.PostalCode<br />@Model.PhoneNumber</p></div><div class="order-customer-card"><span class="eyebrow">Pagesa</span><h2>@Model.Payment?.PaymentMethod</h2><p>Statusi: <strong>@Model.Payment?.PaymentStatus</strong><br />Transaksioni: @Model.Payment?.TransactionId</p></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Produkt</th><th>Sasia</th><th>Total</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><strong>@item.ProductName</strong></td><td>@item.Quantity</td><td>@item.TotalPrice.ToString("0.00") €</td></tr> }</tbody></table></div><div class="order-admin-actions"><form class="form-row" asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><select class="select" name="status"><option selected="@(Model.Status == "Pending" ? "selected" : null)">Pending</option><option selected="@(Model.Status == "Processing" ? "selected" : null)">Processing</option><option selected="@(Model.Status == "Shipped" ? "selected" : null)">Shipped</option><option selected="@(Model.Status == "Completed" ? "selected" : null)">Completed</option><option selected="@(Model.Status == "Cancelled" ? "selected" : null)">Cancelled</option></select><button class="button" type="submit">Përditëso statusin</button></form><strong class="order-total">Totali: @Model.TotalAmount.ToString("0.00") €</strong></div></div>
