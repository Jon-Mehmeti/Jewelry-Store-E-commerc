@model IEnumerable<Order>
@{ ViewData["Title"] = "Porositë"; }
<section class="page-header"><div class="container"><span class="eyebrow">Admin · vetëm për staf</span><h1>Porositë e klientëve</h1><p class="admin-private-note">Kjo hapësirë është e mbrojtur dhe e dukshme vetëm për përdoruesit me rolin Admin.</p></div></section><div class="container section"><div class="admin-stats"><div><strong>@ViewBag.TotalOrders</strong><span>Porosi totale</span></div><div><strong>@ViewBag.PendingOrders</strong><span>Në pritje</span></div><div><strong>@ViewBag.CompletedOrders</strong><span>Të përfunduara</span></div></div><form class="filters admin-filters" method="get"><input class="input" name="search" value="@ViewBag.Search" placeholder="Kërko numër porosie ose email..." /><select class="select" name="status"><option value="">Të gjitha statuset</option><option value="Pending" selected="@(ViewBag.Status == "Pending" ? "selected" : null)">Pending</option><option value="Processing" selected="@(ViewBag.Status == "Processing" ? "selected" : null)">Processing</option><option value="Shipped" selected="@(ViewBag.Status == "Shipped" ? "selected" : null)">Shipped</option><option value="Completed" selected="@(ViewBag.Status == "Completed" ? "selected" : null)">Completed</option><option value="Cancelled" selected="@(ViewBag.Status == "Cancelled" ? "selected" : null)">Cancelled</option></select><button class="button dark" type="submit">Filtro porositë</button></form><div class="table-wrap"><table class="data-table admin-orders-table"><thead><tr><th>Numri</th><th>Klienti</th><th>Data</th><th>Statusi</th><th>Total</th></tr></thead><tbody>@foreach (var order in Model) { <tr><td><a class="link-arrow" asp-action="Details" asp-route-id="@order.Id">#@order.OrderNumber</a></td><td>@order.User?.Email</td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="status-pill status-@order.Status.ToLowerInvariant()">@order.Status</span></td><td>@order.TotalAmount.ToString("0.00") €</td></tr> }</tbody></table></div>@if (!Model.Any()) { <div class="empty-state"><h2>Nuk ka porosi me këto filtra.</h2></div> }</div>
