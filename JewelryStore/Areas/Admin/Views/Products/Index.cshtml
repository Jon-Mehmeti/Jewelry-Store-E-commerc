@model IEnumerable<Product>
@{ ViewData["Title"] = "Produktet"; }
<section class="page-header"><div class="container"><span class="eyebrow">Admin</span><h1>Produktet</h1></div></section><div class="container section"><p><a class="button" asp-action="Create">+ Shto produkt</a></p><table class="data-table"><thead><tr><th>Emri</th><th>Kategoria</th><th>Çmimi</th><th>Stoku</th><th>Aktiv</th><th></th></tr></thead><tbody>@foreach (var product in Model) { <tr><td>@product.Name</td><td>@product.Category?.Name</td><td>@product.Price.ToString("0.00")€</td><td>@product.StockQuantity</td><td>@(product.IsActive ? "Po" : "Jo")</td><td><a class="link-arrow" asp-action="Edit" asp-route-id="@product.Id">Edito</a> <form style="display:inline" asp-action="ToggleActive" method="post"><input type="hidden" name="id" value="@product.Id" /><button class="text-button" type="submit">Ndrysho</button></form></td></tr> }</tbody></table></div>
